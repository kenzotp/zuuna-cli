{"version": 2, "width": 80, "height": 24, "timestamp": 1789775292, "idle_time_limit": 1.2, "env": {"SHELL": "/bin/bash", "TERM": null}, "title": "zuuna: a commit moves the card"}
[0.006474, "o", "\u001b[2m# zuuna — a commit moves the card\u001b[0m\r\n"]
[0.90961, "o", "\u001b[2m# real CLI, real calls. Recorded against our staging server;\u001b[0m\r\n"]
[1.814007, "o", "\u001b[2m# the API token (minted in Developers -> API tokens) stays in\u001b[0m\r\n"]
[2.722649, "o", "\u001b[2m# $ZUUNA_TOKEN and is never printed.\u001b[0m\r\n"]
[3.629828, "o", "\r\n"]
[4.533615, "o", "\u001b[2m# On the staging board sits card QUI-3, column: To do.\u001b[0m\r\n"]
[5.441833, "o", "\u001b[1;32m$\u001b[0m curl -sS \"$ZUUNA_URL/api/v1/cards/QUI-3\" -H \"Authorization: Bearer $ZUUNA_TOKEN\" | jq '{key, status}'\r\n"]
[5.974215, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"key\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"QUI-3\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"status\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"To do\"\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[6.677047, "o", "\r\n"]
[7.581635, "o", "\u001b[2m# 1) Install — one file, no dependencies beyond git + curl\u001b[0m\r\n"]
[8.489851, "o", "\u001b[1;32m$\u001b[0m git init my-project\r\n"]
[8.903552, "o", "Initialized empty Git repository in /tmp/my-project/.git/\r\n"]
[9.612595, "o", "\u001b[1;32m$\u001b[0m cd my-project\r\n"]
[10.729093, "o", "\u001b[1;32m$\u001b[0m curl -o zuuna https://app.zuuna.de/zuuna.sh\r\n"]
[11.14605, "o", "  % Total    % Received % Xferd  Average Speed  Time    Time    Time   Current\r\n                                 Dloa"]
[11.146083, "o", "d  Upload  Total   Spent   Left   Spee"]
[11.146095, "o", "d\r\n\r  0 "]
[11.146111, "o", "     0   0"]
[11.146121, "o", "      "]
[11.146129, "o", "0  "]
[11.146364, "o", " 0      0      0      0                              0"]
[11.163413, "o", "\r100  14513 100  14513   0      0 809."]
[11.16354, "o", "7k      0                              0\r100  14513 100  14513   0      0 805.6k      0                              0\r100  14513 100  1451"]
[11.163571, "o", "3   0      0 802.1k      0                           "]
[11.163592, "o", "   0\r\n"]
[11.869718, "o", "\u001b[1;32m$\u001b[0m chmod +x zuuna\r\n"]
[12.981038, "o", "\r\n"]
[13.883803, "o", "\u001b[2m# 2) Connect this repo — writes .git/zuuna.conf (mode 600) + a post-commit hook\u001b[0m\r\n"]
[14.788291, "o", "\u001b[1;32m$\u001b[0m ./zuuna init \"$ZUUNA_URL\" \"$ZUUNA_TOKEN\"\r\n"]
[15.232611, "o", "✓ zuuna initialised for my-project.\r\n  Commits are now reported automatically. Put a card key like UNI-42 in\r\n  your commit message or branch name to link it to that card.\r\n"]
[15.232706, "o", "\r\n  For releases, add your group id to .git/zuuna.conf:\r\n      ZUUNA_GROUP=<the id in /groups/<id>/releases>\r\n"]
[15.939712, "o", "\r\n"]
[16.844307, "o", "\u001b[2m# 3) Commit with the card key in the subject line\u001b[0m\r\n"]
[17.753103, "o", "\u001b[1;32m$\u001b[0m echo '# demo' > README.md && git add -A\r\n"]
[18.87769, "o", "\u001b[1;32m$\u001b[0m git config user.email demo@example.com && git config user.name Demo\r\n"]
[19.991232, "o", "\u001b[1;32m$\u001b[0m git commit -m 'QUI-3: first commit from a fresh clone'\r\n"]
[20.467283, "o", "[main (root-commit) e712e34] QUI-3: first commit from a fresh clone\r\n"]
[20.467354, "o", " 2 files changed, 337 insertions(+)\r\n create mode 100644 README.md\r\n create mode 100755 zuuna\r\n"]
[21.171758, "o", "\r\n"]
[22.074696, "o", "\u001b[2m# ...nothing. The hook is silent on success — by design.\u001b[0m\r\n"]
[22.977916, "o", "\u001b[2m# Did it work? Look at the card.\u001b[0m\r\n"]
[24.78937, "o", "\u001b[1;32m$\u001b[0m curl -sS \"$ZUUNA_URL/api/v1/cards/QUI-3\" -H \"Authorization: Bearer $ZUUNA_TOKEN\" | jq '{key, status}'\r\n"]
[25.281147, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"key\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"QUI-3\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"status\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"In Progress\"\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[25.984145, "o", "\r\n"]
[26.888293, "o", "\u001b[2m# QUI-3 walked from 'To do' to 'In Progress'. The board mirrors the repo.\u001b[0m\r\n"]
[27.797585, "o", "\u001b[2m# That is the whole loop: card key in the commit subject -> zuuna links\u001b[0m\r\n"]
[28.705824, "o", "\u001b[2m# the commit -> the board's 'A commit is linked' automation moves the card.\u001b[0m\r\n"]
[29.609871, "o", "\u001b[2m# https://github.com/kenzotp/zuuna-cli\u001b[0m\r\n"]
